# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# ---------------------------------------------------------------------------
# Model & API Configuration
# ---------------------------------------------------------------------------
# Gemini platform configuration (default for GCP deployments)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Strategic model routing overrides (Rubric 3.2)
# FAST_MODEL=gemini-3.8-flash
# SMART_MODEL=gemini-pro-latest

# ---------------------------------------------------------------------------
# Persistent Session Backend (Rubric 2.3 — env-var backend swapping)
# ---------------------------------------------------------------------------
# Local default (requires no cloud project): SQLite in gitignored runtime/.
# Plain sqlite:// and postgresql:// URLs are auto-upgraded to async drivers
# (sqlite+aiosqlite:// and postgresql+asyncpg://) by app/app_utils/services.py.
SESSION_DB=sqlite:///./runtime/sessions.db

# Cloud SQL PostgreSQL drop-in (requires asyncpg installed):
# SESSION_DB=postgresql://user:password@127.0.0.1:5432/meeting_prep

# Managed Vertex AI Sessions cloud path (takes precedence over SESSION_DB):
# GOOGLE_CLOUD_AGENT_ENGINE_ID=your-agent-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-east1

# ---------------------------------------------------------------------------
# History Compaction & Sliding-Window Context Budget (Rubric 2.2)
# ---------------------------------------------------------------------------
# Complementary sliding window on model request turns (never touches user: state)
HISTORY_WINDOW=12
# COMPACTION_TOKEN_THRESHOLD=12000
# COMPACTION_EVENT_RETENTION_SIZE=6
# COMPACTION_INTERVAL=6
# COMPACTION_OVERLAP_SIZE=2

# ---------------------------------------------------------------------------
# Async Memory Backend (Rubric 2.4 — env-var backend swapping)
# ---------------------------------------------------------------------------
# local  -> ADK InMemoryMemoryService (default, zero cloud dependencies)
# vertex -> ADK VertexAiMemoryBankService (requires GOOGLE_CLOUD_PROJECT and
#           GOOGLE_CLOUD_AGENT_ENGINE_ID above)
MEMORY_BACKEND=local
